# BN News Gujarati - Environment Configuration
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bn_news_gujarati?schema=public

# Redis & Queue (for BullMQ Background RSS Processing)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=bnnews_secret_jwt_key_development_2026_gujarati_secure_token
JWT_EXPIRES_IN=7d

# URLs & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Media Upload Directory (relative or absolute)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880 # 5MB

# Optional AI Translation / Enhancement
OPENAI_API_KEY=
